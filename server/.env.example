# Copy file này và đổi tên thành .env (Tuyệt đối không push file .env lên Git)
PORT=3000

# Chuỗi kết nối đến Supabase (Các thành viên thay mật khẩu mà nhóm trưởng cung cấp vào chỗ [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.oypswqnajpvggtmzxuzr:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Storage dùng để lưu thumbnail khóa học. Secret key chỉ đặt ở backend, tuyệt đối không dùng trong client.
SUPABASE_URL=https://oypswqnajpvggtmzxuzr.supabase.co
SUPABASE_SECRET_KEY=[YOUR-SUPABASE-SECRET-KEY]

# VNPay Sandbox. VNPAY_HASH_SECRET chỉ đặt ở backend, không đưa sang Vite/client.
VNPAY_TMN_CODE=[YOUR-VNPAY-TMN-CODE]
VNPAY_HASH_SECRET=[YOUR-VNPAY-HASH-SECRET]
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/checkout/vnpay/return
CLIENT_URL=http://localhost:5173
# Configure this public HTTPS endpoint in the VNPay merchant portal:
# https://your-api-domain.example/api/checkout/vnpay/ipn

